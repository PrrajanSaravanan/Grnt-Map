PORT=3001

# ─── LLM provider ────────────────────────────────────────────────────────────
# The agents work with any of these. If unset, the first provider with a key
# configured is used (Groq preferred). A run costs ~4 requests.
#
#   groq       FREE, ~1,000–14,000 req/day, fastest inference   ← recommended
#   openrouter FREE via ":free" models, limits vary
#   cerebras   FREE tier, fast
#   ollama     FULLY LOCAL, no key, no quota (needs Ollama installed)
#   gemini     free tier is only 20 req/day PER MODEL — runs out fast
#
# LLM_PROVIDER=groq

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# OpenRouter — free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — free key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Ollama — no key needed. Install from https://ollama.com, then:
#   ollama pull llama3.1:8b
# and set LLM_PROVIDER=ollama
# OLLAMA_MODELS=llama3.1:8b

# Gemini — https://aistudio.google.com/apikey (comma-separate several keys)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODELS=

# Base URL for the FAISS semantic-match ML service (ml/app.py, run via `uvicorn app:app --port 8000`)
ML_SERVICE_URL=http://127.0.0.1:8000
